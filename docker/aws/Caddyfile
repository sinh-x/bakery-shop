{
    admin off
    auto_https off
    persist_config off
}

:8080 {
    # Container-only probe. ALB should use /api/health so backend readiness is
    # included in service health and failed task revisions are replaced.
    handle /healthz {
        respond "ok" 200
    }

    # ECS containers in one awsvpc task share the task network namespace.
    handle /api/* {
        reverse_proxy 127.0.0.1:2108
    }

    handle {
        root * /srv/web

        @nocache path /index.html /main.dart.js /flutter_bootstrap.js /manifest.json /version.json /assets/FontManifest.json /assets/fonts/MaterialIcons-Regular.otf
        header @nocache Cache-Control "no-cache, must-revalidate"

        @assets {
            path /assets/* /canvaskit/*
            not path /assets/FontManifest.json /assets/fonts/MaterialIcons-Regular.otf
        }
        header @assets Cache-Control "public, max-age=31536000, immutable"

        try_files {path} /index.html
        file_server
    }
}
